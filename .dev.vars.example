DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# For real LLM calls, add a Groq or OpenRouter key and set ENABLE_LLM=true in wrangler.jsonc.
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Optional central admin: set to the UUID assigned when you register, NOT just an email address.
ADMIN_USER_ID=""
# Optional Paddle webhook verification. No actual payment checkout until account configured.
PADDLE_WEBHOOK_SECRET=""

# Only set after Paddle onboarding, price creation and an approved default payment link.
PADDLE_API_KEY=""
PADDLE_PRICE_ID=""
PADDLE_SANDBOX="true"

# Canonical staging control-plane origin for scoped browser jobs (not a secret).
# Set the actual staging hostname before enabling a runner.
PUBLIC_CONTROL_ORIGIN=http://localhost:8787
