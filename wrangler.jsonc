{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "somas-cloudflare-neon",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/s/*",
      "/health",
      "/discussions/*",
      "/platform/managers/*",
      "/idea/*"
    ]
  },
  "vars": {
    "PLATFORM_NAME": "SOMAS",
    "AUTH_V4_ENABLED": "true",
    "CONTACT_IMPORT_ENABLED": "true",
    "BROADCAST_ENABLED": "true",
    "BROADCAST_EMAIL_ENABLED": "false",
    "DOCUMENT_EMAILS_PER_MINUTE": "30",
    "DOCUMENT_EMAILS_PER_DAY": "400"
  },
  "triggers": {
    "crons": []
  }
}
