{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somas-showcase",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/owner", "/inbox.html"] },
  "d1_databases": [{ "binding": "DB", "database_name": "somas-showcase-feedback", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }]
}
