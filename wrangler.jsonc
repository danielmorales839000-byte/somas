{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "somas-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/s/*",
      "/health",
      "/discussions/*"
    ]
  },
  "vars": {
    "PLATFORM_NAME": "SOMAS"
  },
  "triggers": {
    "crons": []
  }
}
