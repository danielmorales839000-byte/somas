{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "somas-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/health"]
  },
  "triggers": {"crons": ["0 4 * * *"]},
  "vars": {
    "PLATFORM_NAME": "SOMAS v2",
    "ENABLE_EXTERNAL_RESEARCH": "false",
    "ENABLE_LLM": "false",
    "FREE_MONTHLY_AI_REQUESTS": "30"
  }
}
