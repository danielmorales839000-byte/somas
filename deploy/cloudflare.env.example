# Copy to .env.cloudflare (ignored by Git); fill values locally, never in chat.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
# For a migration, preserve the original encryption key and immutable owner ID.
# For a new empty database, generate a new key and choose a new immutable ID.
APP_DATA_KEY=
SOMAS_ADMIN_USER_ID=
SOMAS_RUNNER_TOKEN=
# Used only by owner:provision, never sent to Cloudflare.
SOMAS_OWNER_PASSWORD=
